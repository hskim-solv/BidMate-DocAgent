coverage.xml
htmlcov/

# Local environments
.venv/
venv/
.env
.env.*
!.env.example

# OS/editor files
.DS_Store
.idea/
.vscode/
*.swp

# Claude Code: local state (worktrees, transcripts, per-user permissions)
# is ignored; the shared `.claude/settings.json` (hooks etc.) IS committed.
# `.claude/skills/` and `.claude/agents/` are also committed — project-local
# skills/agents shared across clones and worktrees, alongside settings.json.
.claude/*
!.claude/settings.json
!.claude/skills/
!.claude/skills/**
!.claude/agents/
!.claude/agents/**

# Local/private source data
data/files/
data/files_kordoc/
data/data_list.csv
data/data_list.xlsx
eval/*.local.yaml
원본 데이터/
.cache/
.cache/real_eval/
*.sqlite
*.sqlite3
*.db
*.parquet

# Korean public RAG bench (ADR 0018): we fetch KorQuAD on demand and
# never redistribute the raw corpus or the sampled derivative. Sample
# files can be regenerated deterministically with `seed=17`.
data/korean_public/

# Generated artifacts: keep committed portfolio samples, ignore extra outputs
data/index/*
!data/index/index.json
data/index/real100*/
data/index/**/*.faiss
data/index/**/*.index
data/index/**/*.sqlite
data/index/**/*.sqlite3
data/index/**/*.db
data/index/**/*.parquet
data/index/**/*.jsonl
# Local-only OOD experiment indexes and reports stay untracked.
data/ood_legal_index/
reports/ood_legal/
# Per-experiment embedding ablation indices (issue #174 / scripts/run_embedding_ablation.py).
# Multi-GB per model and reproducible from the selected fixture/private corpus
# via the runner; the committed evidence lives in docs/embedding-ablation.md.
data/embedding-ablation/
# Per-experiment embedding ablation eval outputs (issue #389 / scripts/run_embedding_ablation.py).
# eval_summary.json + traces/ per model; reproducible from the selected corpus.
# Headline numbers are committed in docs/embedding-ablation.md so the public repo
# stays small (the raw JSON is ~2 MB per model and traces/ adds another ~2 MB).
reports/embedding-ablation/
# LoRA fine-tuning training pairs (issue #433 / scripts/generate_finetune_pairs.py).
# Generated from the fixture/private corpus via the script; the 5k-scale
# embedding_pairs.jsonl is reproducible with `seed=17`. data/training/sample.jsonl is the committed
# schema reference (~25 representative rows).
data/training/*
!data/training/sample.jsonl
# LoRA fine-tuning notebook artifacts (issue #435 / notebooks/embedding_finetune.ipynb).
# `lora_adapter/` is the trained PEFT delta (~30 MB) — distributed via HF Hub,
# not committed. `notebooks/_artifacts/` holds the training curve PNG and any
# other run outputs that should accompany the writeup on the model card, not
# the repo.
lora_adapter/
notebooks/_artifacts/
# M2 (#207): vectors live in a sidecar .npy file alongside index.json so
# the JSON stays small and a future VectorStore abstraction (#176) can
# swap backends. Both files together are the portfolio sample.
!data/index/embeddings.npy
outputs/*
!outputs/answer.json
reports/*
reports/**/*.local.json
reports/**/*.jsonl
reports/**/*.parquet
reports/**/*.sqlite
reports/**/*.sqlite3
reports/**/*.db
# Aggregate-only artifacts under reports/real100/ are committable
# (ADR 0005 commit boundary). The negation chain below allowlists
# only the explicit aggregate filenames — eval_summary.json and any
# per-case trace stay ignored.
!reports/real100/
reports/real100/*
!reports/real100/baseline.aggregate.json
# Issue #896 — real-100 corpus EDA aggregate (script:
# scripts/eda_real100.py). 4-axis profile of metadata / chunks /
# text_source / eval-cross. ADR 0005 boundary preserved by the script
# (no doc/chunk IDs or raw text; agencies past rank 10 anonymized).
!reports/real100/eda.md
!reports/real100/eda.aggregate.json
!reports/real100/history/
reports/real100/history/*
!reports/real100/history/*.aggregate.json
# Issue #897 — RAG pipeline EDA aggregate (script:
# scripts/rag_pipeline_eda.py). 7-axis pipeline-dynamics profile derived
# from eval_summary.json::case_results. Two surfaces:
#   - reports/rag_pipeline.* (public fixture smoke / local pipeline aggregate)
#   - reports/real100/rag_pipeline.* (private/internal real eval, ADR 0005)
# ADR 0005 boundary preserved by the script (no case IDs, chunk IDs, or
# raw text; retry reason prefixes only).
!reports/rag_pipeline.md
!reports/rag_pipeline.aggregate.json
!reports/real100/rag_pipeline.md
!reports/real100/rag_pipeline.aggregate.json
# Issue #945 — distinguishing-power gauge aggregate (script:
# scripts/distinguishing_power.py, ADR 0053 §Consequences gauge).
# Reads eval_summary.json::ablation.runs, emits (default - floor) /
# (1 - floor) per metric. Aggregate-only (no per-case data); ADR 0005
# boundary preserved by the gauge formula itself.
!reports/real100/distinguishing_power.md
!reports/real100/distinguishing_power.aggregate.json
# Issue #969 — trajectory-rationality judge aggregate (ADR 0056, script:
# scripts/run_rationality_judge.py). Reads eval_summary.json + per-case
# trace JSON, emits 3-axis mean + 95% bootstrap CI + effective_n.
# Aggregate-only (no per-case rationale text or trace data); per-case
# payload at rationality.local.json stays ignored under reports/real100/*.
!reports/real100/rationality.md
!reports/real100/rationality.aggregate.json
# Issue #1002 — failure-mode distribution dashboard (ADR 0059 Phase 5
# supply 2, script: scripts/render_failure_distribution.py). Reads
# eval_summary.json::failure_category_counts (top-level) + abstention_outcomes,
# emits 7-category composition table + ADR 0059 first-match contract check.
# Aggregate-only (no per-case data); the renderer is a read-only consumer
# of the surface introduced by ADR 0059 (PR #1001).
!reports/real100/failure_distribution.md
!reports/real100/failure_distribution.aggregate.json
# Issue #1243 — per-category failure-mode slices (script:
# scripts/render_failure_slices.py). Per-case decomposition of the ADR 0059
# failure surface for audit verifiability (retrieval-miss-inspection.md).
# Aggregate-only — counts/cardinalities only, no query/answer text, doc_id,
# or chunk_id; raw eval_summary.json::case_results stays ignored (line 95).
!reports/real100/failure_slices.aggregate.json
# Issue #1021 — variance source inspection (Issue J, ADR 0059 audit
# follow-up, script: scripts/measure_variance.py). N=5 same-HEAD runs →
# per-category mean/std/min/max + per-case stability + transition matrix.
# Aggregate-only (no per-case query/answer text); raw per-run
# eval_summary.json snapshots stay under variance_runs/ which remains
# ignored under reports/real100/* (line 95 above).
!reports/real100/variance_measurement/
reports/real100/variance_measurement/*
!reports/real100/variance_measurement/REPORT.md
!reports/real100/variance_measurement/aggregate.json
# Issue #1359 — Phase 2.0 real100 retrieval-surface embedding ablation
# (5 models, script: scripts/run_embedding_ablation.py + eval/run_eval.py).
# Reads eval_summary.json::ablation.runs per model, emits per-ablation
# retrieval means + 95% bootstrap CI (chunk_recall@{5,10,20}/mrr/ndcg@10).
# Aggregate-only (no per-case query/answer/chunk text, no doc_id/chunk_id);
# per-model eval_summary.json + index stay ignored (data/embedding-ablation_real/).
!reports/real100/embedding_ablation_retrieval.aggregate.json
# Issue #896 + #897 — EDA figures (PNG + SVG). Same allowlist pattern
# as cost_frontier.png above. corpus EDA: scripts/eda_real100.py /
# RAG EDA: scripts/rag_pipeline_eda.py.
!reports/figures/
reports/figures/*
!reports/figures/real100_meta_*.png
!reports/figures/real100_meta_*.svg
!reports/figures/real100_chunks_*.png
!reports/figures/real100_chunks_*.svg
!reports/figures/real100_text_source_*.png
!reports/figures/real100_text_source_*.svg
!reports/figures/real100_eval_*.png
!reports/figures/real100_eval_*.svg
!reports/figures/real100_rag_*.png
!reports/figures/real100_rag_*.svg
# Issue #798 — cost-accuracy frontier (ADR 0038). Markdown + PNG are
# the rendered artifacts of scripts/plot_cost_frontier.py; check them in
# so reviewers can see the frontier without running the script.
!reports/cost_frontier.md
!reports/cost_frontier.png
# Issue #951 — Phase 2 retrieval-eval (chunking ablation) timestamped runs.
# Aggregate artifacts (REPORT.md / specs / deltas / per-case raw scores)
# cross the commit boundary so reviewers can rerun --reaggregate against
# the same per-case scores. Raw scores carry no doc/chunk IDs or text —
# just qid + category + metric values, ADR 0005 boundary preserved.
!reports/retrieval/
reports/retrieval/*
!reports/retrieval/phase2_chunking_*/
reports/retrieval/phase2_chunking_*/*
!reports/retrieval/phase2_chunking_*/REPORT.md
!reports/retrieval/phase2_chunking_*/chunking_specs.json
!reports/retrieval/phase2_chunking_*/deltas.json
!reports/retrieval/phase2_chunking_*/raw_results.json
# Issue #955 — Phase 3 retrieval-eval (mode ablation) timestamped runs.
# Same aggregate-only commit boundary as phase2_chunking_* above. No
# index build artifacts here — all 4 variants share data/index/real100.
!reports/retrieval/phase3_mode_*/
reports/retrieval/phase3_mode_*/*
!reports/retrieval/phase3_mode_*/REPORT.md
!reports/retrieval/phase3_mode_*/mode_specs.json
!reports/retrieval/phase3_mode_*/deltas.json
!reports/retrieval/phase3_mode_*/raw_results.json
# Phase 3.5 phase35_m3_* runs generated from the 898-chunk csv_text fallback
# are retired invalid private real100 artifacts. Future phase35_m3 reports must
# pass the tracked-artifact regression guard before any explicit allowlist is
# reintroduced.
reports/retrieval/phase35_m3_*/
# Phase 4 retrieval-eval (metadata / filtering ablation) timestamped runs.
# Same aggregate-only commit boundary as phase3_mode_* above. All 4 variants
# share the kordoc 26k index; only plan['metadata_first'] / metadata_filters
# differ. Raw scores carry no doc/chunk text — qid + categories + metric
# values only, ADR 0005 boundary preserved.
!reports/retrieval/phase4_metadata_*/
reports/retrieval/phase4_metadata_*/*
!reports/retrieval/phase4_metadata_*/REPORT.md
!reports/retrieval/phase4_metadata_*/metadata_specs.json
!reports/retrieval/phase4_metadata_*/deltas.json
!reports/retrieval/phase4_metadata_*/raw_results.json
!reports/retrieval/phase4_metadata_*/COVERAGE.md
!reports/retrieval/phase4_metadata_*/coverage.json
# Phase 4 realistic query-time metadata routing (ADR 0065 decision #3).
# Same kordoc 26k index as the oracle ablation; metadata derived from query
# text via match_metadata_targets (no gold injected). Only the aggregate
# REPORT/deltas/specs are committable — qid + categories + metric values
# only, ADR 0005 boundary preserved. raw_results.json stays strictly-local:
# its per-case rows carry gold/extracted agency+project VALUES, i.e. the
# private corpus catalog from data/data_list.csv (a gitignored, pre-commit
# hard-blocked ADR 0005 input) — NOT committable. Regenerate locally via
# scripts/phase4_realistic_metadata_ablation.py.
!reports/retrieval/phase4_realistic_metadata_*/
reports/retrieval/phase4_realistic_metadata_*/*
!reports/retrieval/phase4_realistic_metadata_*/REPORT.md
!reports/retrieval/phase4_realistic_metadata_*/metadata_specs.json
!reports/retrieval/phase4_realistic_metadata_*/deltas.json
# data/index/real100_kordoc — hashing-backend kordoc 26k index (Phase 4
# corpus, matches Phase 3's kordoc corpus). Reproducible from data/files
# via scripts/build_index.py --hwp_loader kordoc --pdf_loader kordoc
# --embedding_backend hashing with BIDMATE_KORDOC_CACHE_DIR=data/files_kordoc.
data/index/real100_kordoc/
# Issue #237 — harness aggregate snapshots. Generated per ``run_harness``
# invocation; untracked by default to keep developer working trees
# clean. Harness history is isolated from committed private/internal
# aggregate reports.
reports/harness_history/
# LLM-judge per-case verdicts (ADR 0006) stay local — only their
# aggregate is folded into baseline.aggregate.json. Explicit ignore
# for clarity (already caught by reports/real100/* above).
reports/real100/judge.local.json

# ADR 0032 — routed-subset embedding comparison aggregate is committable;
# raw per-model index dirs + trace files stay local (.routed_measurement_tmp/).
!reports/embedding_routed.json

# ADR 0029 — real-data case proposer aggregate is committable;
# per-case proposed/reviewed yaml stays local. Mirrors the
# ADR 0005 / 0006 split.
!reports/proposed/
reports/proposed/*
!reports/proposed/proposer.aggregate.json

# ADR 0064 — self-review external-judge cross-rating. Each quarter's
# <Qx-YYYY>.json carries verdicts + agreement stats only (✓/△/✗, Cohen's κ,
# confusion counts) — no body text, no per-case excerpts — so the rubric↔anchor
# agreement is auditable in-repo. Mirrors the ADR 0005 metadata-only boundary.
!reports/self_review_agreement/
reports/self_review_agreement/*
!reports/self_review_agreement/*.json

# ADR 0032 — routed-subset measurement aggregate is committable.
# Hashing-backend framework-validation + future sentence-transformers
# spread results land here (embedding_routed.json).
!reports/embedding_routed.json

# Benchmark raw/local artifacts
artifacts/benchmarks/
artifacts/runs/
artifacts/matrices/
experiments/runs/

# Harness private overlays (paired with eval/*.local.yaml). Only the
# *.example.yaml templates are committed.
harness/*.local.yaml
harness/real.yaml
