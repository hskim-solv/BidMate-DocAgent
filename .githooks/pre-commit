#!/usr/bin/env bash
# Pre-commit hook for BidMate-DocAgent.
#
# Activate per-developer with:
#   git config core.hooksPath .githooks
#
# Behavior: hard-blocks commits that include files from the private side of
# the eval split (ADR 0005). These paths are `.gitignore`d, but `git add -f`
# or other force-paths can bypass that. The hook is the second line of
# defense, aligned with `.gitignore`.
#
# Bypass with `git commit --no-verify` only if you are intentionally
# committing an aggregate artifact that the allowlist regex below failed to
# match — and please fix the allowlist in that same change.

set -u

# Blocked path patterns (regex). Must mirror `.gitignore`'s ADR 0005 boundary.
BLOCKED_PATTERNS=(
  '^data/files/'
  '^data/data_list\.csv$'
  '^data/data_list\.xlsx$'
  '^eval/.*\.local\.yaml$'
  '^reports/real[^/]*/'
)

# Allowlist (regex). These aggregate artifacts ARE safe to commit; they
# mirror the `!`-rules in `.gitignore`.
ALLOWED_PATTERNS=(
  '^reports/real100/baseline\.aggregate\.json$'
  '^reports/real100/history/[^/]+\.aggregate\.json$'
  # Issue #896 — real-100 corpus EDA aggregate (script:
  # scripts/eda_real100.py). Mirrors the `!`-rule in `.gitignore`.
  '^reports/real100/eda\.md$'
  '^reports/real100/eda\.aggregate\.json$'
  # Issue #897 — RAG pipeline EDA aggregate (script:
  # scripts/rag_pipeline_eda.py). Synthetic + real-100 surfaces.
  '^reports/rag_pipeline\.md$'
  '^reports/rag_pipeline\.aggregate\.json$'
  '^reports/real100/rag_pipeline\.md$'
  '^reports/real100/rag_pipeline\.aggregate\.json$'
  # Issue #945 — distinguishing-power gauge aggregate (script:
  # scripts/distinguishing_power.py, ADR 0053 §Consequences). Mirrors
  # the `!`-rule in `.gitignore`.
  '^reports/real100/distinguishing_power\.md$'
  '^reports/real100/distinguishing_power\.aggregate\.json$'
  # Issue #969 — trajectory-rationality judge aggregate (script:
  # scripts/run_rationality_judge.py, ADR 0056).  Mirrors the `!`-rule
  # in `.gitignore`.  Per-case rationality.local.json stays ignored.
  '^reports/real100/rationality\.md$'
  '^reports/real100/rationality\.aggregate\.json$'
  # Issue #1002 — failure-mode distribution dashboard (script:
  # scripts/render_failure_distribution.py, ADR 0059 Phase 5 supply 2).
  # Mirrors the `!`-rule in `.gitignore`. Aggregate-only — read-only
  # consumer of the ADR 0059 failure_category_counts surface.
  '^reports/real100/failure_distribution\.md$'
  '^reports/real100/failure_distribution\.aggregate\.json$'
  # Issue #1243 — per-category failure-mode slices (script:
  # scripts/render_failure_slices.py). Per-case decomposition of the ADR
  # 0059 failure surface for audit verifiability. Aggregate-only — counts/
  # cardinalities only, no text/doc_id/chunk_id.
  '^reports/real100/failure_slices\.aggregate\.json$'
  # Issue #1451 — verifier_false_negative overlap analysis (script:
  # scripts/render_verifier_false_negative_overlap.py). Aggregate-only
  # counts/buckets for retrieval/citation/unsupported overlap.
  '^reports/real100/verifier_false_negative_overlap\.aggregate\.json$'
  # Multi-chunk evidence failure analysis (script:
  # scripts/render_multi_chunk_evidence_failures.py). Aggregate-only
  # counts/buckets for gold/retrieved chunk coverage and expected impact.
  '^reports/real100/multi_chunk_evidence_failures\.aggregate\.json$'
  # Multi-chunk retrieval strategy decision (script:
  # scripts/render_multi_chunk_retrieval_strategy.py). Mirrors the `!`-rule in
  # `.gitignore`; aggregate-only recommendation/provenance, no raw case rows.
  '^reports/real100/multi_chunk_retrieval_strategy\.aggregate\.json$'
  # Issue #1469 — difficulty profiler (script:
  # scripts/render_difficulty_profile.py, ADR 0077). Aggregate-only
  # difficulty buckets and outcome means; raw case rows and index text stay
  # ignored.
  '^reports/real100/difficulty_profile\.md$'
  '^reports/real100/difficulty_profile\.aggregate\.json$'
  # Issue #1021 — variance source inspection (script:
  # scripts/measure_variance.py, ADR 0059 Issue J audit). N=5 same-HEAD
  # runs → per-category mean/std/min/max + per-case stability + transition
  # matrix. Aggregate-only (no per-case text); raw run snapshots under
  # variance_runs/ stay ignored.
  '^reports/real100/variance_measurement/REPORT\.md$'
  '^reports/real100/variance_measurement/aggregate\.json$'
  # Issue #1359 — Phase 2.0 real100 retrieval-surface embedding ablation
  # (scripts/run_embedding_ablation.py + eval/run_eval.py). Per-model
  # per-ablation retrieval means + 95% bootstrap CI. Mirrors the `!`-rule
  # in `.gitignore`. Aggregate-only — no per-case query/answer/chunk text,
  # no doc_id/chunk_id; per-model eval_summary.json + index stay ignored.
  '^reports/real100/embedding_ablation_retrieval\.aggregate\.json$'
  # real100_v2 RFP benchmark rebuild. Aggregate-only inventory,
  # question distribution, baseline, and tier split artifacts; raw eval
  # summaries/questions/evidence/index text stay ignored.
  '^reports/real100_v2/README\.md$'
  '^reports/real100_v2/parse_inventory\.aggregate\.json$'
  '^reports/real100_v2/question_distribution\.aggregate\.json$'
  '^reports/real100_v2/baseline\.aggregate\.json$'
  '^reports/real100_v2/benchmark_tiers\.aggregate\.json$'
  '^reports/real100_v2/latency_cost_budget\.aggregate\.json$'
  '^reports/real100_v2/reranker_candidate_budget\.aggregate\.json$'
  '^reports/real100_v2/context_packing\.aggregate\.json$'
  '^reports/real100_v2/metric_suite\.aggregate\.json$'
  '^reports/real100_v2/metric_suite\.md$'
  '^reports/real100_v2/retrieval_diagnostics\.aggregate\.json$'
)

# Guard: ADR file deletion/rename (CLAUDE.md Prohibited).
# ADR files that already live on origin/main must not be deleted or renamed —
# mark Superseded in Status block and keep the file. In-PR draft renames
# (a renumber before the ADR has ever been merged) are allowed since they
# cannot affect the project record. Issue #817 surfaced this: ADR 0046
# drafted on PR #820 had to renumber to 0047 mid-flight when PR #824 raced
# in and shipped a different 0046 first — the original hook blocked the
# legitimate fix and forced manual intervention.
#
# This is the first line of defence; branch-and-issue-check.yml is the
# backup gate that catches --no-verify bypasses on merged-ADR deletions.
adr_dr_raw=$(git diff --cached --name-status --diff-filter=DR -- 'docs/adr/*.md' 2>/dev/null || true)
if [[ -n "$adr_dr_raw" ]]; then
  # For each rename/delete, only block when the OLD path existed on
  # origin/main (the merged-ADR protection scope). When origin/main is
  # unreachable (offline / fresh clone before fetch), fall back to
  # blocking everything so the conservative direction wins.
  blocked=""
  while IFS=$'\t' read -r flag p1 p2; do
    [[ -z "$flag" ]] && continue
    old="$p1"  # D: only path; R*: old path is the first
    if git rev-parse --verify --quiet origin/main >/dev/null 2>&1; then
      if git cat-file -e "origin/main:$old" 2>/dev/null; then
        blocked+="$flag"$'\t'"$old"$'\n'
      fi
    else
      blocked+="$flag"$'\t'"$old"$'\n'  # offline fallback: block
    fi
  done <<< "$adr_dr_raw"

  if [[ -n "$blocked" ]]; then
    cat >&2 <<'EOFERR'

❌ Pre-commit hook blocked: a merged ADR file is being deleted or renamed.

   CLAUDE.md Prohibited: "Deleting or renaming ADR files. Mark Superseded
   in the Status block; keep the file."

   Affected files (existed on origin/main):
EOFERR
    echo -n "$blocked" | sed 's/^/     /' >&2
    cat >&2 <<'EOFERR'

   To fix: restore the file and add "Status: Superseded by ADR XXXX"
   to its header instead of deleting it.

       git restore --staged <file>

EOFERR
    exit 1
  fi
fi

# Guard: ADR number collision (issue #757 — A2 fix from governance self-audit).
# Catches the "two ADR files sharing the same NNNN prefix" failure mode that
# concurrent worktrees + manual `Reserve ADR numbers up front` (CLAUDE.md)
# has repeatedly produced (0022→0023, 0023→0025, 0029→0030; live PR #740
# collision on 0044 caught 2026-05-15). Fires only when this commit adds
# new ADR file(s); reads filesystem so it catches duplicates that any
# previous commit / merge brought in too.
#
# Bypass with --no-verify only mid-merge; open a follow-up issue to fix.
adr_added=$(git diff --cached --name-only --diff-filter=A -- 'docs/adr/[0-9]*.md' 2>/dev/null || true)
if [[ -n "$adr_added" ]]; then
  collision_out=$(python3 scripts/_governance.py --check-adr-collision 2>&1)
  if [[ $? -ne 0 ]]; then
    echo "$collision_out" >&2
    exit 1
  fi

  # Guard: ADR Consequences verification lint (issue #793 — B3 fix).
  # Newly added ADR files must include a `## Verification` section + at least
  # one `<!-- verifies-key: path:key -->` marker. Existing 41 ADRs are
  # grandfathered; retrofit happens per-ADR in follow-up PRs. The lint also
  # checks that any marker pointing at an existing file actually contains
  # the key substring — catches "promise that isn't wired up" early.
  #
  # Bypass with --no-verify only mid-merge; open a follow-up to add the
  # missing section.
  while IFS= read -r adr_file; do
    [[ -z "$adr_file" ]] && continue
    lint_out=$(python3 scripts/_governance.py --lint-adr-consequences "$adr_file" 2>&1)
    if [[ $? -ne 0 ]]; then
      echo "$lint_out" >&2
      exit 1
    fi
  done <<< "$adr_added"

  # Guard: ADR ↔ README index parity (issue #803 — shift-left of the
  # tests/test_governance.py::test_no_unlinked_adr_files_on_disk CI gate).
  # An ADR PR that lands without a matching `| [NNNN](./NNNN-*.md) |` row
  # in docs/adr/README.md reds main on merge and cascades red Pytest across
  # every open PR (see #730 / #732 / #750 recurrence trail). The pre-commit
  # check uses the *staged* README content (`git show :docs/adr/README.md`)
  # so the row must be staged in the same commit — not just sitting in the
  # working tree.
  #
  # Pass all newly added ADR paths in one call (argparse nargs='+') so the
  # error message lists everything that's missing instead of stopping at
  # the first violator.
  adr_added_args=()
  while IFS= read -r adr_file; do
    [[ -z "$adr_file" ]] && continue
    adr_added_args+=("$adr_file")
  done <<< "$adr_added"
  if [[ ${#adr_added_args[@]} -gt 0 ]]; then
    # `--readme-staged` precedes `--check-adr-readme-parity` so argparse
    # consumes it first (store_true flag, zero args); otherwise nargs='+'
    # on --check-adr-readme-parity sees `--readme-staged` as the next
    # option boundary and exits with "expected at least one argument".
    parity_out=$(python3 scripts/_governance.py \
      --readme-staged \
      --check-adr-readme-parity "${adr_added_args[@]}" 2>&1)
    if [[ $? -ne 0 ]]; then
      echo "$parity_out" >&2
      exit 1
    fi
  fi
fi

# Guard: ADR ↔ README index *status* parity (issue #1181 — extends the
# #803 filename-parity guard above to the Status column). A proposed->
# accepted flip that updates an ADR file's `- **Status**:` header but leaves
# the docs/adr/README.md index row stale passes the filename-parity check
# (the row still exists) and test_no_unlinked_adr_files_on_disk, yet drifts
# the reviewer-facing index. Unlike the #803 guard (ADR *additions* only),
# this fires on any ADR-file OR index-README *modification* (ACMR), since a
# status flip is an edit, not an add. Working-tree scan (like the deadlink
# guard below); the canonical gate is tests/test_governance.py post-push.
#
# Bypass with --no-verify only mid-merge; open a follow-up to re-sync.
adr_or_readme_touched=$(git diff --cached --name-only --diff-filter=ACMR -- 'docs/adr/[0-9]*.md' 'docs/adr/README.md' 2>/dev/null || true)
if [[ -n "$adr_or_readme_touched" ]]; then
  status_out=$(python3 scripts/_governance.py --check-adr-readme-status 2>&1)
  if [[ $? -ne 0 ]]; then
    echo "$status_out" >&2
    exit 1
  fi
fi

# Guard: ADR ↔ ADR supersede cross-ref integrity (issue #1077). When an ADR
# supersedes / changes the invariant of an older ADR, the older ADR's Status
# block + cross-ref must stay in sync. The #1181 guard above covers ADR-file ↔
# README-index drift; this covers ADR-file ↔ ADR-file drift (a `Superseded by`
# pointer with a stale Status, a dangling supersede target, or a structured
# `Supersedes` whose target lacks the reciprocal back-pointer). ADR 0022's
# proposed->accepted flip surfaced only in a later external-review round
# because no PR-time gate fired (PR #1068/#1075 patched after the fact).
# Fires on any ADR-file modification (ACMR); working-tree scan, like the
# #1181 guard. Canonical gate is tests/test_governance.py post-push.
#
# Bypass with --no-verify only mid-merge; open a follow-up to re-sync.
adr_touched=$(git diff --cached --name-only --diff-filter=ACMR -- 'docs/adr/[0-9]*.md' 2>/dev/null || true)
if [[ -n "$adr_touched" ]]; then
  crossref_out=$(python3 scripts/_governance.py --check-adr-crossref 2>&1)
  if [[ $? -ne 0 ]]; then
    echo "$crossref_out" >&2
    exit 1
  fi
fi

# Guard: markdown cross-reference dead links (issue #1060).
# Whenever any `.md` is staged, scan the WHOLE doc tree (not just the staged
# files): the recurring failure is a file MOVE that breaks an inbound link
# from a file this commit never touched (commits 627a63b / 9754f69 / da80073,
# "repair cross-references after batch reorg"). A staged-only scan structurally
# cannot catch that. The scan is stdlib regex over the tracked `*.md` set
# (<1s). Canonical enforcement is tests/test_doc_links.py (CI, post-push); this
# is the shift-left copy so the author finds out at `git commit` time.
#
# Residual gap: renaming a link TARGET (e.g. rag_core.py) without staging any
# `.md` will not trip this hook — the pytest CI gate catches that case.
#
# Bypass with --no-verify only mid-merge; open a follow-up to fix the link.
md_staged=$(git diff --cached --name-only --diff-filter=ACMR -- '*.md' 2>/dev/null || true)
if [[ -n "$md_staged" ]]; then
  links_out=$(python3 scripts/check_doc_links.py --check-all 2>&1)
  if [[ $? -ne 0 ]]; then
    echo "$links_out" >&2
    exit 1
  fi
fi

# Guard: Phase 4 eval-artifact privacy (CONTENT scan).
# reports/retrieval/phase4*/ artifacts are committable (allowlisted in
# .gitignore) but sit OUTSIDE the ADR 0005 path block below (which only
# matches ^reports/real[^/]*/ and never sees reports/retrieval/...). PRs
# #1108 / #1123 leaked private real-eval data through this gap — coverage.json
# sample_queries (raw query text) + raw_results.json per-case agency/project
# labels. The path-regex below structurally cannot inspect JSON contents, so
# whenever a phase4 JSON artifact is staged we run a field-level scan that
# enforces the "qid + categories + metric values only" boundary (ADR 0065).
#
# Residual gap: the scan reads the working-tree content of tracked files, so a
# stage-clean-then-dirty race is not caught here — the pytest CI gate
# tests/test_phase4_artifact_privacy_regression.py is the backstop.
#
# Bypass with --no-verify only if deliberately committing a sanitized artifact
# the scan mis-flags — and fix PHASE4_PRIVATE_KEYS in the same change.
phase4_staged=$(git diff --cached --name-only --diff-filter=ACMR -- 'reports/retrieval/phase4*' 2>/dev/null || true)
if [[ -n "$phase4_staged" ]]; then
  phase4_out=$(python3 scripts/_governance.py --check-phase4-privacy 2>&1)
  if [[ $? -ne 0 ]]; then
    echo "$phase4_out" >&2
    exit 1
  fi
fi

# Guard: structural eval-artifact privacy (CONTENT scan, #1204).
# Broader than the phase4 key-name gate above: any committable JSON under
# reports/retrieval/ or reports/real100/ must carry zero Hangul (anonymized
# qids are real_<hex>; categories/metrics are ASCII/numeric) and zero
# colon-bearing dict keys (retry-reason payloads embed agency names / 공고번호
# doc-ids). The check uses NO name list — listing the real agency names in
# committed source would itself re-leak them. Fires whenever such a JSON OR
# one of the sanitizing generators is staged. tests/
# test_eval_artifact_privacy_regression.py is the CI backstop.
eval_priv_staged=$(git diff --cached --name-only --diff-filter=ACMR -- \
  'reports/retrieval/*.json' 'reports/real100/*.json' 'reports/real100_v2/*.json' \
  'scripts/_ablation_common.py' 'scripts/run_real_eval_delta.py' \
  'scripts/eda_real100.py' 'scripts/phase*_ablation.py' 2>/dev/null || true)
if [[ -n "$eval_priv_staged" ]]; then
  eval_priv_out=$(python3 scripts/_governance.py --check-eval-privacy 2>&1)
  if [[ $? -ne 0 ]]; then
    echo "$eval_priv_out" >&2
    exit 1
  fi
fi

staged=$(git diff --cached --name-only --diff-filter=ACMR 2>/dev/null || true)

if [[ -z "$staged" ]]; then
  exit 0
fi

violations=()
while IFS= read -r file; do
  [[ -z "$file" ]] && continue

  # Skip files that match the allowlist.
  allowed=0
  for allow_pat in "${ALLOWED_PATTERNS[@]}"; do
    if [[ "$file" =~ $allow_pat ]]; then
      allowed=1
      break
    fi
  done
  [[ "$allowed" -eq 1 ]] && continue

  # Flag files that match a blocked pattern.
  for block_pat in "${BLOCKED_PATTERNS[@]}"; do
    if [[ "$file" =~ $block_pat ]]; then
      violations+=("$file")
      break
    fi
  done
done <<< "$staged"

if [[ ${#violations[@]} -gt 0 ]]; then
  cat >&2 <<EOF

❌ Pre-commit hook blocked: staged files violate the ADR 0005 commit boundary.

   The following are on the private side of the eval split and must not
   enter git:

EOF
  for f in "${violations[@]}"; do
    echo "     - $f" >&2
  done
  cat >&2 <<EOF

   These paths are .gitignored, so you typically don't see them. If you
   used \`git add -f\` to force-add, undo with:

       git restore --staged ${violations[*]}

   See ADR 0005 (docs/adr/0005-eval-split-public-synthetic-private-local.md)
   and docs/private-100-doc-experiments.md.

   Bypass with \`git commit --no-verify\` only if you are intentionally
   committing an aggregate artifact that the allowlist regex failed to
   match — and please fix the allowlist in the same change.

EOF
  exit 1
fi

exit 0
